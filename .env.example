# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
PARSE_MODEL=gpt-5.4-nano
REPLY_MODEL=gpt-5.4-mini
REASONING_EFFORT=none

# Django backend + shared secrets (must match Innayaat_backend/.env)
BACKEND_URL=http://127.0.0.1:8000/api/
BACKEND_SERVICE_KEY=
PRICE_PASS_SECRET=

# Optional
REDIS_URL=
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Local dev servers on any port are allowed by default; in production set this empty
CORS_ORIGIN_REGEX=
